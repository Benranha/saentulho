# Copie para .env (que já está no .gitignore) e cole a chave.
KIE_AI_API_KEY=

# Feed de artigos do ADC — o ambiente onde os artigos são pautados e aprovados.
# Quem lê estas duas é scripts/gerar-artigos.mjs, no build: as páginas de
# artigo são geradas aqui e servidas como HTML estático, igual ao resto do site.
# Sem as variáveis o gerador não falha — escreve uma /artigos vazia e sai com 0,
# porque ADC fora do ar não pode derrubar o deploy do site inteiro.
#
# ADC_URL é a origem do ADC, sem barra no fim.
# ADC_CHAVE é `<site>.<segredo>` — para este site, `saentulho.<segredo>`.
# O segredo é o valor de APC_SITE_SAENTULHO_CHAVE lá no ADC. É a chave que
# decide quais artigos este site enxerga: artigo endereçado a outro dos quatro
# sites não aparece aqui nem trocando parâmetro na URL.
ADC_URL=
ADC_CHAVE=

# Domínio público do site, usado no sitemap.xml e nas URLs canônicas.
# Tem um padrão no gerador; só preencha se for diferente.
SITE_URL=
